# ─────────────────────────────────────────────────────────────────────────────
# 1Kosmos Partner Portal — Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# For local development the docker-compose db service is used.
DATABASE_URL=postgres://pp_user:pp_secret@localhost:5432/partnerportal?sslmode=disable

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL, found in Settings → API.
SUPABASE_URL=https://your-project.supabase.co

# Public anon key — safe to use in client-side code.
SUPABASE_ANON_KEY=your-anon-key

# Service-role key — keep this secret; grants full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens.
# Must be at least 32 characters long. Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-min-32-chars

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API server will listen on.
PORT=8080

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── SendGrid ──────────────────────────────────────────────────────────────────
# API key for the SendGrid email delivery service.
SENDGRID_API_KEY=your-sendgrid-key

# The "From" address used in all outgoing emails.
FROM_EMAIL=noreply@1kosmos.com

# ── Anthropic / AI ────────────────────────────────────────────────────────────
# API key for Anthropic Claude. Used for AI-powered portal features.
ANTHROPIC_API_KEY=your-anthropic-key

# ── Storage ───────────────────────────────────────────────────────────────────
# Name of the Supabase Storage bucket used for file uploads.
STORAGE_BUCKET=partner-portal

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum log level: trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=info

# ── Runtime environment ───────────────────────────────────────────────────────
# Affects behaviour such as pretty-printing logs and relaxed TLS checks.
# Values: development | staging | production
ENV=development
